{
  "bridgeUrl": "ws://127.0.0.1:8081",
  "broadcastPort": 8082,
  "pollIntervalMs": 1000,
  "activeDevice": "conveyor-sorting",
  "devices": {
    "conveyor-sorting": {
      "protocol": "modbus",
      "host": "192.168.1.10",
      "port": 502,
      "vars": [
        "START", "RESET", "STOP",
        "SENSOR_FEED", "SENSOR_COLOR", "SENSOR_MATERIAL",
        "MAGNETIC_FEED_RETRACT", "MAGNETIC_FEED_EXTEND",
        "MAGNETIC_SORTING1_RETRACT", "MAGNETIC_SORTING1_EXTEND",
        "MAGNETIC_SORTING2_RETRACT", "MAGNETIC_SORTING2_EXTEND",
        "FEED_CYLINDER_VALVE", "SORTING1_CYLINDER_VALVE", "SORTING2_CYLINDER_VALVE",
        "CONVEYOR",
        "SIGNAL_TOWER_RED", "SIGNAL_TOWER_GREEN", "SIGNAL_TOWER_YELLOW"
      ]
    },
    "pneumatic-robot": {
      "protocol": "modbus",
      "host": "192.168.1.11",
      "port": 502,
      "vars": [
        "BUTTON_START", "BUTTON_ESTOP", "BUTTON_STOP",
        "MAG_FORWARD_REAR", "MAG_FORWARD_FRONT",
        "MAG_LIFT_REAR", "MAG_LIFT_FRONT",
        "MAG_CLAMP_OPEN", "MAG_CLAMP_CLOSE",
        "SOLENOID_FORWARD_RETRACT", "SOLENOID_FORWARD_EXTEND",
        "SOLENOID_LIFT_RETRACT", "SOLENOID_LIFT_EXTEND",
        "SOLENOID_CLAMP_OPEN", "SOLENOID_CLAMP_CLOSE",
        "INDICATOR_ORIGIN", "INDICATOR_WORKING", "INDICATOR_PROCESSING", "INDICATOR_ALARM"
      ]
    },
    "traffic-light": {
      "protocol": "modbus",
      "host": "192.168.1.12",
      "port": 502,
      "vars": [
        "BUTTON_START", "BUTTON_STOP", "BUTTON_ESTOP",
        "LIGHT_EW_GREEN", "LIGHT_EW_YELLOW", "LIGHT_EW_RED",
        "LIGHT_NS_GREEN", "LIGHT_NS_YELLOW", "LIGHT_NS_RED"
      ]
    },
    "auto-dispensing": {
      "protocol": "modbus",
      "host": "127.0.0.1",
      "port": 1505,
      "variables": {
        "BUTTON_START": 0, "BUTTON_STOP": 1, "BUTTON_RESET": 2, "BUTTON_ESTOP": 3, "BUTTON_CONFIRM": 4,
        "S_LIMIT_START": 10, "S_LIMIT_END": 11,
        "S_MAG_A_EMPTY": 12, "S_MAG_B_EMPTY": 13, "S_MAG_C_EMPTY": 14, "S_MAG_D_EMPTY": 15,
        "S_BIN_HAS_DRUG": 16,
        "MSC_A_BACK": 20, "MSC_A_FRONT": 21,
        "MSC_B_BACK": 22, "MSC_B_FRONT": 23,
        "MSC_C_BACK": 24, "MSC_C_FRONT": 25,
        "MSC_D_BACK": 26, "MSC_D_FRONT": 27,
        "MSC_TILT_HOLD": 28, "MSC_TILT_DUMP": 29,
        "MOTOR_FWD": 30, "MOTOR_REV": 31,
        "CYL_SEND_A": 32, "CYL_SEND_B": 33, "CYL_SEND_C": 34, "CYL_SEND_D": 35, "CYL_TILT": 36,
        "LAMP_GREEN": 38, "LAMP_YELLOW": 39, "LAMP_RED": 40,
        "CYL_SEND_A_RETRACT": 41, "CYL_SEND_B_RETRACT": 42, "CYL_SEND_C_RETRACT": 43,
        "CYL_SEND_D_RETRACT": 44, "CYL_TILT_RETRACT": 45
      },
      "words": {
        "ENCODER_PULSES": {
          "type": "dint32",
          "wordOrder": "low-first",
          "modbus": { "address": 120, "words": 2 },
          "s7": { "address": "MDI120", "words": 1 },
          "mitsubishi": { "address": "D120", "words": 2 }
        }
      },
      "vars": [
        "MOTOR_FWD", "MOTOR_REV",
        "CYL_SEND_A", "CYL_SEND_B", "CYL_SEND_C", "CYL_SEND_D", "CYL_TILT",
        "LAMP_GREEN", "LAMP_YELLOW", "LAMP_RED",
        "CYL_SEND_A_RETRACT", "CYL_SEND_B_RETRACT", "CYL_SEND_C_RETRACT",
        "CYL_SEND_D_RETRACT", "CYL_TILT_RETRACT"
      ],
      "wordVars": ["ENCODER_PULSES"]
    }
  }
}
