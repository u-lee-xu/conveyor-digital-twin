{
  "name": "digital-twin-monorepo",
  "description": "数字孪生仿真平台 Monorepo",
  "version": "1.0.0",
  "author": "老徐",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:conveyor": "npm run dev -w @digital-twin/conveyor-sorting",
    "dev:coal": "npm run dev -w @digital-twin/coal-sorting",
    "build:conveyor": "npm run build -w @digital-twin/conveyor-sorting",
    "build:coal": "npm run build -w @digital-twin/coal-sorting",
    "electron:build:win:conveyor": "npm run electron:build:win -w @digital-twin/conveyor-sorting",
    "electron:build:win:coal": "npm run electron:build:win -w @digital-twin/coal-sorting",
    "websocket:start": "cd websocket-server && npm start",
    "websocket:dev": "cd websocket-server && npm run dev",
    "start:conveyor": "concurrently \"npm run websocket:dev\" \"npm run dev:conveyor\"",
    "start:coal": "concurrently \"npm run websocket:dev\" \"npm run dev:coal\"",
    "dev:pneumatic": "npm run dev -w @digital-twin/pneumatic-robot",
    "start:pneumatic": "concurrently \"npm run websocket:dev\" \"npm run dev:pneumatic\"",
    "test:conveyor": "npm run test -w @digital-twin/conveyor-sorting",
    "test:coal": "npm run test -w @digital-twin/coal-sorting",
    "lint": "eslint packages/"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
