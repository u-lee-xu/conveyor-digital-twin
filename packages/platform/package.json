{
  "name": "@digital-twin/platform",
  "productName": "数字孪生仿真平台",
  "description": "多设备统一平台 - 数字孪生教学软件（启动页 + 统一模式框架 + 连接管理）",
  "version": "1.0.0",
  "author": "老徐",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "types": "src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "electron:dev": "vite --mode electron",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@digital-twin/conveyor-sorting": "*",
    "@digital-twin/pneumatic-robot": "*",
    "@digital-twin/traffic-light": "*",
    "@digital-twin/auto-dispensing": "*",
    "@digital-twin/shared": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.27",
    "electron": "34.5.8",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.digital-twin.platform",
    "productName": "数字孪生仿真平台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../../websocket-server/server.js",
        "to": "websocket-server/server.js"
      },
      {
        "from": "../../websocket-server/dint32.js",
        "to": "websocket-server/dint32.js"
      },
      {
        "from": "../../websocket-server/runtime-role.js",
        "to": "websocket-server/runtime-role.js"
      },
      {
        "from": "../../websocket-server/node_modules",
        "to": "websocket-server/node_modules"
      }
    ],
    "electronLanguages": ["zh-CN"],
    "cscLink": null,
    "win": {
      "signingHashAlgorithms": [],
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
