{
  "name": "@digital-twin/pneumatic-robot",
  "productName": "气动机械手数字孪生系统",
  "description": "三气缸气动机械手数字孪生仿真平台",
  "version": "1.3.0",
  "author": "老徐",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "vite --mode electron",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "test": "vitest"
  },
  "dependencies": {
    "@digital-twin/shared": "*",
    "@react-three/drei": "^10.7.7",
    "@react-three/rapier": "^2.2.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.27",
    "electron": "34.5.8",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.1",
    "three": "^0.183.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.2.4",
    "zustand": "^5.0.11"
  },
  "build": {
    "appId": "com.digital-twin.pneumatic-robot",
    "productName": "气动机械手数字孪生系统",
    "directories": {
      "output": "release_v2"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "electronLanguages": [
      "zh-CN"
    ],
    "cscLink": null,
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "../../websocket-server",
        "to": "websocket-server"
      }
    ],
    "win": {
      "artifactName": "${productName}-多协议-Setup-${version}.${ext}",
      "signingHashAlgorithms": [],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
